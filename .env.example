# Port du serveur (API + front compilé)
PORT=8490
# Clé TMDB v3 (gratuite, themoviedb.org → Settings → API)
TMDB_API_KEY=
# Comptes initiaux : nom:motdepasse séparés par des virgules. Vide = mots de passe générés au premier lancement.
FLIX_USERS=
# Dossier des données (base + images). Défaut : ./data
DATA_DIR=

# Adresse publique principale, et anciennes adresses à rediriger vers elle (séparées par des virgules)
CANONICAL_HOST=
REDIRECT_HOSTS=
